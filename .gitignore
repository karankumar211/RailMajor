# =============================================================================
# RailOpt AI - Root .gitignore
# =============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.cover

# Virtual Environments
venv/
.venv/
env/
ENV/

# Local SQLite Databases
*.db
*.sqlite
*.sqlite3

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# Node / Frontend Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
