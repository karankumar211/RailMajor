# =============================================================================
# RailOpt AI - Backend Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env and adjust variables as required:
# cp .env.example .env

PROJECT_NAME="RailOpt AI"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database connection string (SQLite by default, PostgreSQL supported)
DATABASE_URL="sqlite:///./railopt.db"

# JWT Secret Key for controller authentication sessions (min 32 characters in production)
JWT_SECRET="railopt-ai-secret-control-room-ops-key-sih-2026-secure-32bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
